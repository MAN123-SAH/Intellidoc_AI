# IntelliDoc AI — Environment Variables Template
# Copy this file to runtime_app/backend/.env and set your own values.
# NEVER commit your actual .env with real API keys to Git.

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/intellidoc

# ─── Google Gemini API Key (Required for Multimodal Extraction) ───
GEMINI_API_KEY=your_gemini_api_key_here

# ─── File Storage ─────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ─── JWT Authentication ───────────────────────────────
SECRET_KEY=change_this_to_a_long_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Model Paths ──────────────────────────────────────
LAYOUTLMV3_CHECKPOINT=offline_research/checkpoints/layoutlmv3_funsd/final_model

# ─── Application ──────────────────────────────────────
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000
